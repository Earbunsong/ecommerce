    {
      "name": "4. Rate limit (run this request 11 times)",
      "item": [
        {
          "name": "Login wrong password (repeat until 429)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sophea@shopkh.test\",\n  \"password\": \"wrong-password\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401 until the limit, then 429 RATE_LIMITED', () => {",
                  "  pm.expect([401, 429]).to.include(pm.response.code);",
                  "  if (pm.response.code === 429) {",
                  "    pm.expect(pm.response.json().error.code).to.eql('RATE_LIMITED');",
                  "    pm.expect(Number(pm.response.headers.get('Retry-After'))).to.be.above(0);",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        }
      ]
