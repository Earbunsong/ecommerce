{
  "info": {
    "name": "ShopKH API",
    "description": "Endpoints built so far (Phase 0–3). Start the API first: `docker compose up -d` then `pnpm dev` (or `pnpm --filter api dev`).\n\nAuth: the login/register requests save the `shopkh_auth` cookie into the collection variable `authCookie`; protected requests send it in a `Cookie` header. Logout clears it.\n\nDemo accounts (after `pnpm db:seed`): admin@shopkh.test / Admin123!, dara@shopkh.test / Customer123!, sophea@shopkh.test / Customer123!\n\nRate limit: 10 login and 10 register attempts per 15 minutes. Restarting the API resets the counters.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "authCookie",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "imageId",
      "value": ""
    },
    {
      "key": "categoryId",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Save the auth cookie from any response that sets it",
          "const setCookie = pm.response.headers.all().filter(h => h.key.toLowerCase() === 'set-cookie').map(h => h.value);",
          "for (const c of setCookie) {",
          "  if (c.startsWith('shopkh_auth=')) {",
          "    const pair = c.split(';')[0];",
          "    pm.collectionVariables.set('authCookie', pair === 'shopkh_auth=' ? '' : pair);",
          "  }",
          "}",
          "// Every error must have the standard shape (architecture §4.10)",
          "if (pm.response.code >= 400) {",
          "  pm.test('Error has standard shape { error: { code, message } }', () => {",
          "    const body = pm.response.json();",
          "    pm.expect(body.error.code).to.be.a('string');",
          "    pm.expect(body.error.message).to.be.a('string');",
          "  });",
          "}",
          "pm.test('Response never contains the password hash', () => {",
          "  pm.expect(pm.response.text()).to.not.match(/password_?hash|\\$argon2/i);",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 and status ok', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().status).to.eql('ok');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Auth – happy path",
      "item": [
        {
          "name": "Register new customer (random email)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Test Customer\",\n  \"email\": \"Test{{$randomInt}}{{$randomInt}}@Example.com\",\n  \"phone\": \"+855 12 345 678\",\n  \"password\": \"password123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created, logged in immediately', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(pm.collectionVariables.get('authCookie')).to.not.be.empty;",
                  "});",
                  "pm.test('Email saved in lowercase, phone normalized', () => {",
                  "  const u = pm.response.json().user;",
                  "  pm.expect(u.email).to.eql(u.email.toLowerCase());",
                  "  pm.expect(u.phone).to.eql('012345678');",
                  "  pm.expect(u.role).to.eql('customer');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as customer (Dara)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
