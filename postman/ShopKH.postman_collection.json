              "raw": "{\n  \"stockQuantity\": 999\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('400', () => pm.response.to.have.status(400));"]
              }
            }
          ]
        },
        {
          "name": "Upload image (choose a JPG/PNG/WebP file in Body)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Cookie",
                "value": "{{authCookie}}"
              }
            ],
            "url": "{{baseUrl}}/admin/products/{{productId}}/images",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "altText",
                  "value": "Front view",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('imageId', pm.response.json().image.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Product with images",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "{{authCookie}}"
              }
            ],
            "url": "{{baseUrl}}/admin/products/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Set image as primary",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "{{authCookie}}"
              }
            ],
            "url": "{{baseUrl}}/admin/products/{{productId}}/images/{{imageId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isPrimary\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Delete image",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Cookie",
                "value": "{{authCookie}}"
              }
            ],
            "url": "{{baseUrl}}/admin/products/{{productId}}/images/{{imageId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('204', () => pm.response.to.have.status(204));"]
              }
            }
          ]
        },
        {
          "name": "Deactivate product (hidden from shop)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "{{authCookie}}"
              }
            ],
            "url": "{{baseUrl}}/admin/products/{{productId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isActive\": false\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Customer tries admin route → 403",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "{{authCookie}}"
              }
            ],
            "url": "{{baseUrl}}/admin/products"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Log in as Dara (folder 2) first, or this returns 401",
                  "pm.test('401 or 403', () => pm.expect([401, 403]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
