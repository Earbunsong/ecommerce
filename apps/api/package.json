{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "node -e \"console.log('db:generate: added in Phase 1')\"",
    "db:migrate": "node -e \"console.log('db:migrate: added in Phase 1')\"",
    "db:seed": "node -e \"console.log('db:seed: added in Phase 1')\"",
    "db:create-admin": "node -e \"console.log('db:create-admin: added in Phase 1')\""
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@hono/zod-validator": "^0.9.1",
    "hono": "^4.13.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
