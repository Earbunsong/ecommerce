NODE_ENV=development
PORT=3000

# Docker PostgreSQL (docker-compose.yml) listens on host port 5433
DATABASE_URL=postgres://shopkh:shopkh@localhost:5433/shopkh
TEST_DATABASE_URL=postgres://shopkh:shopkh@localhost:5433/shopkh_test

JWT_SECRET=change-me-to-a-long-random-string
WEB_ORIGIN=http://localhost:5173
# COOKIE_DOMAIN=   # only for the sibling-subdomain setup (architecture §8)

SHIPPING_FEE_CENTS=150
FREE_SHIPPING_THRESHOLD_CENTS=3000
ORDER_PAYMENT_TIMEOUT_MINUTES=15
ENABLE_MOCK_PAYMENTS=true

STORAGE_DRIVER=local

# Used only by db:create-admin in production; remove after use
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
